// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      "shift shift": "file_finder::Toggle",
      "ctrl--": "zed::DecreaseBufferFontSize",
      "ctrl-+": "zed::IncreaseBufferFontSize",
      "ctrl-0": "zed::ResetBufferFontSize",

      "ctrl-alt-+": "zed::IncreaseUiFontSize",
      "ctrl-alt--": "zed::DecreaseUiFontSize",
      "ctrl-alt-0": "zed::ResetUiFontSize",

    },
  },
  {
    "context": "Editor",
    "bindings": {
      "alt-up": "editor::MoveLineUp",
      "alt-down": "editor::MoveLineDown",
      "shift-alt-up": "editor::DuplicateLineUp",
      "shift-alt-down": "editor::DuplicateLineDown",

      "ctrl-k ctrl-u": ["editor::ToggleComments",{ "advance_downwards": false },],
      "ctrl-shift-ů": [
        "action::Sequence",
        [
          "editor::ToggleCodeLens",
          "editor::ToggleInlayHints"
        ]
      ],
      "ctrl-shift-§": "editor::ToggleInlineDiagnostics",
    },
    "unbind": {
      "ctrl-shift-§": "editor::ExpandAllDiffHunks",
    }
  },

